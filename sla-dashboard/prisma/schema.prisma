generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  ext_expires_in    Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  passwordHash  String?

  accounts    Account[]
  sessions    Session[]
  solicitudes Solicitud[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  dominio   String   @unique
  pais      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitudes Solicitud[]
}

// Responsable de atender cada tipo de proceso, según el país del cliente.
// paisCliente = "*" aplica a cualquier país (se usa si no hay coincidencia exacta).
model ResponsableProceso {
  id                String   @id @default(cuid())
  tipoProceso       String
  paisCliente       String   @default("*")
  responsable       String
  correoResponsable String
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tipoProceso, paisCliente])
}

model Solicitud {
  id                String    @id @default(cuid())
  asunto            String
  cuerpo            String
  remitente         String
  encargado         String? // Responsable asignado según tipoProceso y paisCliente
  correoResponsable String?
  fechaRecibido     DateTime
  inicioConteoSLA   DateTime?
  vencimientoSLA    DateTime?
  fechaRespuesta    DateTime?
  tiempoHabil       String?
  estadoSLA         String?
  estado            String    @default("en_gestion")
  slaHoras          Float     @default(2)

  conversationId String?
  clienteId      String?
  nombreCliente  String?
  tipoProceso    String?
  paisCliente    String?
  correoCliente  String?

  evidenciaRespuesta String?
  resumen            String?
  observaciones      String?
  clasificacionIA    String?
  confianzaIA        Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messageId String?  @unique

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, fechaRecibido])
}

enum Role {
  USER
  ADMIN
}